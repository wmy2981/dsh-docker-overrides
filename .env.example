# 复制为 .env 后按需修改：cp .env.example .env
COMPOSE_PROJECT_NAME=dsh
LOCAL_IMAGE=local/deepseek-harness:0.2.2-rc.3-r1-market.1-tools.1
DSH_BIND_ADDRESS=192.168.1.100
DSH_PORT=3081
DSH_DESKTOP_PORT=6081
NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# XDG 目录：基础镜像默认放 /tmp，重启即失；这里改到持久化的 $HOME 下。
# 用 DSH_ 前缀是为了避免和宿主机自身的 XDG_* 变量冲突（compose 会优先取 shell 环境变量）。
DSH_XDG_CONFIG_HOME=/home/node/.config
DSH_XDG_DATA_HOME=/home/node/.local/share
DSH_XDG_CACHE_HOME=/home/node/.cache
